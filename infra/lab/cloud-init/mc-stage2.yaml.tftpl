#cloud-config
# Stage-2 lab VM (${role}). Base OS only; services, Tailscale, TLS lab CA and
# node firewall are configured later by Ansible (04-proxmox-lab.md §2, LAB05).
# Contains only a public key; no secrets.
hostname: ${hostname}
manage_etc_hosts: true

users:
  - name: mesh
    gecos: mesh-controlplane lab admin
    shell: /bin/bash
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

# 04-proxmox-lab.md §5: key-only SSH on lab VMs.
ssh_pwauth: false
disable_root: true

package_update: true
package_upgrade: false
packages:
  - qemu-guest-agent
  - ca-certificates
  - curl
  - jq
  - python3

runcmd:
  - systemctl enable --now qemu-guest-agent
  - touch /var/lib/mesh-lab-bootstrap-done
