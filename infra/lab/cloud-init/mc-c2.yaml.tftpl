#cloud-config
# mc-c2: second cluster process (stage 2a); reached through mc-cp over the LAN.
hostname: ${hostname}
manage_etc_hosts: true

users:
  - name: mesh
    gecos: mesh-controlplane lab admin
    shell: /bin/bash
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

ssh_pwauth: false
disable_root: true

package_update: true
package_upgrade: false
packages:
  - qemu-guest-agent
  - nftables
  - ca-certificates
  - curl
  - jq
  - sqlite3

runcmd:
  - systemctl enable --now qemu-guest-agent
  - touch /var/lib/mesh-lab-bootstrap-done
