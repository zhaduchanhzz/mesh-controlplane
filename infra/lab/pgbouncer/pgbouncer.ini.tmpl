;; PgBouncer of each PG node (P13b, ADR 0011 §D, ADR 0006 §3-4). Installed as
;; /etc/pgbouncer/pgbouncer.ini on mc-pg-01/02 by infra/lab/pg/setup-pgbouncer.sh
;; (@IP@ = the node's LAN address). Same pooling settings as mc-db's mc-pgb
;; (infra/lab/db/setup-db.sh); every server connection goes to the local
;; HAProxy (127.0.0.1:5000), which follows the Patroni primary.

[databases]
; Catch-all: per-run E2E/drill databases (e2e_*, p13*_*) until every cluster
; uses its own alias (pgbouncer/README.md); then remove it.
* = host=127.0.0.1 port=5000
; Per-cluster data and lease aliases, mesh_ops (P13f D9b, P13b).
%include /etc/pgbouncer/pgbouncer-clusters.ini

[pgbouncer]
listen_addr = @IP@
listen_port = 6432
unix_socket_dir = /var/run/postgresql
logfile = /var/log/postgresql/pgbouncer.log
pidfile = /var/run/postgresql/pgbouncer.pid

; Clients: SCRAM for headscale from the lab LAN only (nftables narrows 6432 to
; the cluster VMs and mc-ci). Admin console: no admin_users; PgBouncer lets
; user `pgbouncer` in over the unix socket when the peer runs under its own
; uid (`sudo -u postgres psql -h /var/run/postgresql -p 6432 -U pgbouncer
; pgbouncer`), and nobody else.
auth_type = hba
auth_hba_file = /etc/pgbouncer/pg_hba.conf
auth_file = /etc/pgbouncer/userlist.txt

pool_mode = transaction
max_prepared_statements = 200
default_pool_size = 20
max_client_conn = 2000
max_db_connections = 80
ignore_startup_parameters = extra_float_digits

; ADR 0006 §3.4 / P12c B2: below the lease self-fence deadline (8 s).
query_wait_timeout = 5
idle_transaction_timeout = 5

; Failover behaviour (P13b): a failed server login is retried after 1 s, not
; the default 15 s, so pools refill as soon as HAProxy points at the new
; primary; a connect attempt gives up after 2 s.
server_login_retry = 1
server_connect_timeout = 2
server_idle_timeout = 300
server_check_delay = 5
; Defence in depth for the HAProxy routing (haproxy-pg.cfg, option
; redispatch): a pooled server connection idle for server_check_delay is
; checked before reuse and dropped if it sits on a replica (division by zero
; in recovery), so a session left on a demoted primary dies on its next
; reuse instead of serving read-only errors until server_lifetime.
server_check_query = SELECT 1 / (1 - pg_is_in_recovery()::int)
server_lifetime = 3600

; TCP keepalive towards clients and HAProxy (dead peers found in ~19 s
; instead of the kernel's 2 h).
tcp_keepalive = 1
tcp_keepidle = 10
tcp_keepintvl = 3
tcp_keepcnt = 3
